#!/usr/bin/env bash
# tts -- dev-side CLI for spoken Claude output.
#
# Runs as `dev`. dev cannot reach Ethan's audio server (multi-user isolation), so
# this side only ever: reads the session transcript, filters it to speakable prose
# (lib/narrate.py), synthesizes a WAV (kokoro, or piper as a fallback), and drops
# the WAV in a shared spool. An ethan-side systemd path unit plays it. See README.
#
# Subcommands:
#   tts say         synthesize my latest response now and queue it for playback
#   tts speak FILE  synthesize the text of an arbitrary file and queue it
#   tts stop        stop playback immediately and clear the queue
#   tts on|off      enable/disable always-on for THIS session (default off)
#   tts volume [N]  show, or set (0-150), playback volume percent (shared/global)
#   tts status      show this session's always-on state + queue depth + volume
#   tts hook        internal: called by the Stop hook; no-op unless this session is on
#   tts speak-drain internal: synth every queued text file (dev-side path unit)
#
# Zero tokens: pure local read -> filter -> synth -> file drop.
set -uo pipefail

# ---- config (override in ~/.config/claude-tts/config, shell syntax) ----
# Engine: "kokoro" (higher quality, flows across sentences), "piper" (the
# original fast binary), or "auto" (kokoro if its venv+model are present, else
# piper). Default auto -- so a box without the kokoro install still speaks.
TTS_ENGINE="${TTS_ENGINE:-auto}"

# --- piper (fallback engine) ---
PIPER_BIN="${TTS_PIPER_BIN:-$HOME/.local/opt/piper/piper}"
VOICE="${TTS_VOICE:-$HOME/.local/share/piper/voices/en_US-lessac-medium.onnx}"
LENGTH_SCALE="${TTS_LENGTH_SCALE:-1.0}"   # piper rate: higher = slower

# --- kokoro (preferred engine; see setup/install-kokoro.sh) ---
KOKORO_VENV="${KOKORO_VENV:-$HOME/.local/opt/kokoro-venv}"
KOKORO_PY="${KOKORO_PY:-$KOKORO_VENV/bin/python}"
KOKORO_SYNTH="${KOKORO_SYNTH:-$HOME/.local/share/claude-tts/kokoro_synth.py}"
KOKORO_MODEL="${KOKORO_MODEL:-$HOME/.local/share/kokoro/kokoro-v1.0.onnx}"
KOKORO_VOICES="${KOKORO_VOICES:-$HOME/.local/share/kokoro/voices-v1.0.bin}"
KOKORO_VOICE="${KOKORO_VOICE:-af_heart}"
KOKORO_SPEED="${KOKORO_SPEED:-1.0}"       # kokoro rate: higher = faster
KOKORO_LANG="${KOKORO_LANG:-en-us}"
KOKORO_GAP="${KOKORO_GAP:-0.12}"          # seconds of silence between chunks

SPOOL="${TTS_SPOOL:-/srv/dev/tts/queue}"
NARRATE="${TTS_NARRATE:-$HOME/.local/share/claude-tts/narrate.py}"
FLAG_DIR="${TTS_FLAG_DIR:-$HOME/.claude/tts}"
PROJECT_DIR="${TTS_PROJECT_DIR:-$HOME/.claude/projects/-srv-dev}"
_CFG="$HOME/.config/claude-tts/config"
[ -r "$_CFG" ] && . "$_CFG"

SID="${CLAUDE_CODE_SESSION_ID:-unknown}"
INCOMING="$SPOOL/incoming"
BUILDING="$SPOOL/building"
CONTROL="$SPOOL/control"
# Text queued for synthesis from OUTSIDE a Claude session (e.g. the clipboard):
# a producer drops a .txt here, the dev-side synth path unit runs `speak-drain`.
TEXT_INCOMING="$SPOOL/text-incoming"
TEXT_FAILED="$SPOOL/text-failed"

die(){ printf 'tts: %s\n' "$*" >&2; exit 1; }

# True if the kokoro engine is fully installed (venv, synth script, model,
# voices). `auto` uses this to decide; `kokoro` requires it.
_kokoro_ready() {
    [ -x "$KOKORO_PY" ] && [ -f "$KOKORO_SYNTH" ] \
        && [ -f "$KOKORO_MODEL" ] && [ -f "$KOKORO_VOICES" ]
}

# Synthesize $1 (text) into WAV $2 with kokoro. Returns nonzero on any failure
# so the caller can fall back to piper.
_synth_kokoro() {
    printf '%s\n' "$1" | "$KOKORO_PY" "$KOKORO_SYNTH" \
        --model "$KOKORO_MODEL" --voices "$KOKORO_VOICES" --out "$2" \
        --voice "$KOKORO_VOICE" --speed "$KOKORO_SPEED" \
        --lang "$KOKORO_LANG" --gap "$KOKORO_GAP" >/dev/null 2>&1
}

# Synthesize $1 (text) into WAV $2 with piper.
_synth_piper() {
    [ -x "$PIPER_BIN" ] || return 1
    printf '%s\n' "$1" | "$PIPER_BIN" --model "$VOICE" \
        --length_scale "$LENGTH_SCALE" --output_file "$2" >/dev/null 2>&1
}

# Synthesize $1 (text) into WAV $2 using the configured engine, honoring
# TTS_ENGINE and falling back to piper if kokoro is selected-but-unusable.
# Echoes the engine actually used; returns nonzero if synthesis failed.
_synth_wav() {
    local text="$1" out="$2"
    case "$TTS_ENGINE" in
        piper)     # explicit: piper only, fail loudly if it can't synth
            _synth_piper "$text" "$out" && { echo piper; return 0; }
            return 1 ;;
        kokoro)    # explicit: kokoro only, so a broken install is visible
            _kokoro_ready || return 1
            _synth_kokoro "$text" "$out" && { echo kokoro; return 0; }
            return 1 ;;
        auto)      # kokoro when usable, else silently fall back to piper
            if _kokoro_ready && _synth_kokoro "$text" "$out"; then
                echo kokoro; return 0
            fi
            _synth_piper "$text" "$out" && { echo piper; return 0; }
            return 1 ;;
        *)
            die "unknown TTS_ENGINE '$TTS_ENGINE' (use kokoro, piper, or auto)" ;;
    esac
}

# Synthesize a block of prose into a WAV and drop it in the spool for playback.
# This is the shared back half of the pipeline: every source (a transcript, an
# arbitrary file) resolves to text, then hands it here.
#   $1 = text   $2 = 1 for verbose (on-demand), 0 for quiet (hook)
_queue_text() {
    local text="$1" verbose="$2" ts base tmp out engine
    if [ -z "${text//[[:space:]]/}" ]; then
        [ "$verbose" = 1 ] && echo "tts: nothing speakable to say"
        return 0
    fi
    # At least one engine must be usable.
    if ! _kokoro_ready && [ ! -x "$PIPER_BIN" ]; then
        die "no TTS engine available (run setup/install-kokoro.sh or setup/install-piper.sh)"
    fi
    mkdir -p "$INCOMING" "$BUILDING"
    ts="$(date +%s%N)"; base="${ts}-${SID}"
    tmp="$BUILDING/$base.wav"          # synthesize outside incoming/ ...
    out="$INCOMING/$base.wav"
    if ! engine="$(_synth_wav "$text" "$tmp")"; then
        rm -f "$tmp"; die "synthesis failed (engine=$TTS_ENGINE)"
    fi
    mv -f "$tmp" "$out"                # ... then atomically reveal; play.path fires
    [ "$verbose" = 1 ] && echo "tts: queued $(basename "$out") via $engine ($(wc -c <"$out") bytes)"
    return 0
}

# Synthesize a transcript's latest response into the spool.
#   $1 = transcript path   $2 = 1 for verbose (on-demand), 0 for quiet (hook)
_synth() {
    local transcript="$1" verbose="$2" text
    [ -f "$transcript" ] || { [ "$verbose" = 1 ] && die "no transcript at $transcript"; return 0; }
    text="$(python3 "$NARRATE" "$transcript" 2>/dev/null)" || die "narrate failed"
    _queue_text "$text" "$verbose"
}

cmd_say() {
    _synth "$PROJECT_DIR/$SID.jsonl" 1
}

# Speak an arbitrary file: read it, strip markdown to prose (narrate --raw),
# and queue. The generic entry point -- any text file, not just a transcript.
cmd_speak() {
    local file="${1:-}" text
    [ -n "$file" ] || die "usage: tts speak FILE"
    [ -f "$file" ] || die "no such file: $file"
    [ -r "$file" ] || die "cannot read file: $file"
    text="$(python3 "$NARRATE" --raw "$file" 2>/dev/null)" || die "narrate failed"
    _queue_text "$text" 1
}

# Drain the text spool: synthesize every queued .txt, oldest first, then remove
# it. Triggered by the dev-side claude-tts-synth.path unit whenever a producer
# (the clipboard keybind, say) drops text that originates outside a Claude
# session. Per-file resilient: a bad file is parked in text-failed/, never
# retried in a loop, and never aborts the rest of the drain.
cmd_speak_drain() {
    mkdir -p "$TEXT_INCOMING" "$TEXT_FAILED"
    shopt -s nullglob
    local files=("$TEXT_INCOMING"/*.txt) f text
    [ "${#files[@]}" -gt 0 ] || exit 0     # nothing queued; path unit re-arms
    for f in "${files[@]}"; do
        [ -f "$f" ] || continue
        text="$(python3 "$NARRATE" --raw "$f" 2>/dev/null)"
        if [ -z "${text//[[:space:]]/}" ]; then
            rm -f "$f"; continue           # empty / no speakable text -> just drop
        fi
        # Run the synth in a subshell so a single failure (_queue_text calls die)
        # parks that file and moves on instead of killing the whole drain.
        if ( _queue_text "$text" 0 ); then
            rm -f "$f"
        else
            mv -f "$f" "$TEXT_FAILED/" 2>/dev/null || rm -f "$f"
        fi
    done
}

cmd_stop() {
    mkdir -p "$CONTROL" "$INCOMING"
    rm -f "$INCOMING"/*.wav 2>/dev/null || true
    : > "$CONTROL/STOP"               # fires stop.path -> ethan kills paplay
    echo "tts: stop requested"
}

cmd_on() {
    mkdir -p "$FLAG_DIR"
    : > "$FLAG_DIR/$SID.on"
    echo "tts: always-on ENABLED for this session ($SID)"
}

cmd_off() {
    rm -f "$FLAG_DIR/$SID.on"
    echo "tts: always-on disabled for this session ($SID)"
}

# Playback volume is a single global percent kept in the shared spool
# (control/volume), so it crosses the dev->ethan boundary the same way STOP does:
# dev writes it, the ethan-side player reads it and passes paplay --volume.
# Absent = 100%.
_read_volume() {
    local v=100
    if [ -r "$CONTROL/volume" ]; then
        v="$(cat "$CONTROL/volume" 2>/dev/null)"
        case "$v" in ''|*[!0-9]*) v=100 ;; esac
    fi
    printf '%s' "$v"
}

cmd_volume() {
    mkdir -p "$CONTROL"
    if [ "$#" -eq 0 ]; then
        echo "tts: volume=$(_read_volume)%"
        return 0
    fi
    local pct="$1"
    case "$pct" in ''|*[!0-9]*) die "volume must be an integer percent 0-150 (got '$pct')" ;; esac
    [ "$pct" -le 150 ] || die "volume capped at 150% (got '$pct')"
    printf '%s\n' "$pct" > "$CONTROL/volume"
    echo "tts: volume set to ${pct}%"
}

cmd_status() {
    local state n engine
    [ -e "$FLAG_DIR/$SID.on" ] && state=ON || state=off
    n="$(find "$INCOMING" -maxdepth 1 -name '*.wav' 2>/dev/null | wc -l)"
    case "$TTS_ENGINE" in
        piper)       engine=piper ;;
        kokoro|auto) _kokoro_ready && engine=kokoro || engine="piper(fallback)" ;;
        *)           engine="$TTS_ENGINE?" ;;
    esac
    echo "tts: session=$SID always-on=$state engine=$engine queued=$n volume=$(_read_volume)%"
}

cmd_hook() {
    # Called by the Stop hook with the hook JSON on stdin. Resolve session +
    # transcript from that JSON (fall back to env), and speak only if this
    # session opted in. Silent + cheap when off: a single flag-file check.
    local json sid tr
    json="$(cat 2>/dev/null || true)"
    sid="$(printf '%s' "$json" | jq -r '.session_id // empty' 2>/dev/null)"
    tr="$(printf '%s' "$json" | jq -r '.transcript_path // empty' 2>/dev/null)"
    [ -n "$sid" ] || sid="$SID"
    [ -n "$tr" ] || tr="$PROJECT_DIR/$sid.jsonl"
    [ -e "$FLAG_DIR/$sid.on" ] || exit 0
    SID="$sid"                        # so the queued filename carries the session
    _synth "$tr" 0
}

usage() {
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

case "${1:-}" in
    say)         cmd_say ;;
    speak)       shift; cmd_speak "$@" ;;
    speak-drain) cmd_speak_drain ;;
    stop)        cmd_stop ;;
    on)          cmd_on ;;
    off)         cmd_off ;;
    volume)      shift; cmd_volume "$@" ;;
    status)      cmd_status ;;
    hook)        cmd_hook ;;
    ""|-h|--help|help) usage 0 ;;
    *) die "unknown subcommand '$1' (try: say speak stop on off volume status)" ;;
esac
