# claude-tts config -- copy to ~/.config/claude-tts/config and edit.
# Sourced by `tts` as shell, so use shell assignment syntax.

# --- kokoro synth engine (run setup/install-kokoro.sh once) ---
# Voice (see the Kokoro voice list, e.g. af_heart, af_bella, am_michael, bf_emma):
# KOKORO_VOICE="af_heart"
# Speaking rate -- higher is faster (1.0 = default):
# KOKORO_SPEED=1.0
# Silence in seconds inserted between packed chunks (lower = tighter flow):
# KOKORO_GAP=0.12
